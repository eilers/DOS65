              ;version 2.19-S
              ;released:	30 november 1985 (2.10)
              ;last revised:
              ;	2 may 1996 (2.11)
              ;		eliminated word mode for 1024 blocks
              ;		made extent a single byte
              ;	3 may 1996 (2.12)
              ;		added initial exm related code
              ;	11 may 1996 (2.13)
              ;		added use of exm in getblk
              ;		added code to set exm & cexm1f
              ;		corrected errors
              ;	19 may 1996 (2.14)
              ;		changed ccm ren to "to from" syntax
              ;		allowed _ in file names
              ;	13 march 2008 (2.15)
              ;		reformatted for TASM & ASM210+
              ;		eliminated dependence on "IBM" format
              ;		  by reading first sector # using SIM+51
              ;		  TRANSLATE code. If translate
              ;		  does not have first physical sector in first
              ;		  position this approach may not work.
              ;		  SIM can also perform no translation at all.
              ;		  Also assumes BOOT & SIM both know correct
              ;		  starting sector for cold & warm boot. It
              ;		  should work regardless of physical sector
              ;		  size as long as existing SIM is configured
              ;		  correctly for destination drive. BOOT
              ;		  must correctly handle sectors > 128 bytes
              ;		  as must WARM BOOT in SIM.
              ;		  In any case BOOT and WARM BOOT must
              ;		  read sectors in sequential order, i.e.,
              ;		  no interleave.
              ;	17 december 2009 (2.16)
              ;		added page zero start variable - pzstrt
              ;		change page zero start & switch to use pzstrt
              ;	1 march 2011 (2.17)
              ;		change opening message
              ;	6 March 2015 (2.18)
              ;		corrected calculations associated with writing image
              ;	19 August 2015 (2.19)
              ;		corrected file name parsing
              ;this program contains the complete dos/65 operating
              ;system except for the boot and sim.
              ;when used by the system operator this program
              ;provides the capability to construct a new
              ;operating system including the users boot and sim.
              ;the system is relocated to fit the memory size
              ;specified by the user and is written onto
              ;the system tracks of the specified drive.
              ;improvements over version 2.0 include:
              ;	use of "from to" syntax for ren
              ;	addition of go command
              ;	addition of load command
              ;	ability to enter numbers as decimal or hex
              ;	address parameter added to save
              ;	error checking in sysgen (write)
              ;	write type for deblocking added
              ;	page zero 0 & 1 not used (see also pzstrt use)
              ;	allow _ in file names
              ;base addresses and definitions
0002          pzstrt	=	$2		;start of page zero "free" RAM
0100          btejmp	=	$100		;warm boot jump
0103          pemjmp	=	$103		;jump to pem
0106          iostat	=	$106		;i/o status
0107          dflfcb	=	$107		;default fcb
0128          dflbuf	=	$128		;default buffer
0200          tea	=	$200		;tea start
0800          ccmlng	=	2048		;ccm length
0c00          pemlng	=	3072		;pem length
0020          paglim	=	((ccm+ccmlng+pemlng)/256)+1	;allow one page for sim
              ;zero page for setup
ffffffff          	*=	pzstrt
0002          trknum				;current track
0002          	*=	*+2
0004          dcbadd				;dcb address
0004          	*=	*+2
0006          nmsstr				;number system tracks
0006          	*=	*+2
0008          nsectr				;number sectors per track
0008          	*=	*+2
000a          ttlsec				;total sectors to write
000a          	*=	*+1
000b          trkcnt				;track count for image write
000b          	*=	*+2
000d          size				;ascii size
000d          	*=	*+2
000f          lokim				;low kim limit
000f          	*=	*+2
0011          hikim				;high kim limit
0011          	*=	*+2
0013          offset				;relocation offset
0013          	*=	*+2
0015          kimcnt				;kim counter
0015          	*=	*+1
0016          pointr				;pointer
0016          	*=	*+2
0018          lengt				;inst length
0018          	*=	*+1
0019          point				;relocate pointer
0019          	*=	*+2
001b          adjust				;relocate distance
001b          	*=	*+2
001d          kimpnt				;kim file index
001d          	*=	*+1
001e          savex				;save for x
001e          	*=	*+1
001f          savey				;save for y
001f          	*=	*+1
0020          number				;input pack buffer
0020          	*=	*+2
0022          dstdrv				;destination drive
0022          	*=	*+1
0023          defalt				;default drive
0023          	*=	*+1
0024          seccnt				;sector count
0024          	*=	*+2
0026          secnum				;sector number
0026          	*=	*+2
0028          curccm				;start of current ccm
0028          	*=	*+2
002a          simlng				;length of sim
002a          	*=	*+2
002c          room				;memory needed for sysgen
002c          	*=	*+2
002e          stksav				;save stack register
002e          	*=	*+1
002f          frstsc				;first sector number of disk
002f          	*=	*+1
0030          lastzp
              ;fixed parameters
000a          lf	=	$a		;linefeeed
000d          cr	=	$d		;return
001a          eof	=	$1a		;end of file
0000          null	=	0		;null
0003          ctlc	=	3		;abort
0005          ctle	=	5		;physical cr lf
0009          ctli	=	9		;tab character
0010          ctlp	=	$10		;toggle printer
0012          ctlr	=	$12		;repeat line
0013          ctls	=	$13		;freeze
0018          ctlx	=	$18		;cancel
003b          semico	=	$3b		;semicolon
007f          delete	=	$7f		;delete character
0024          numcmd	=	36		;number commands

              	.STORE Start,Ende-Start,"sysgn219.com"
0200          Start	=	tea

              ;main program
0030          	*=	Start		;start of tea
0200 4c 28 02 	jmp	sysgen		;jump to main
              ;copyright notice
0203 43 4f 50 	.byte	"COPYRIGHT (C) 2009 - "
0218 52 49 43 	.byte	"RICHARD A. LEARY"
0228 ac 02 01 sysgen	ldy	btejmp+2	;get sim page from boot vector
022b 8c e4 03 	sty	jshome+2
022e 8c e7 03 	sty	jsseld+2
0231 8c ea 03 	sty	jssett+2
0234 8c ed 03 	sty	jssets+2
0237 8c f0 03 	sty	jssetd+2
023a 8c f8 03 	sty	jswrit+4
023d 8c f3 03 	sty	jsxlat+2
              ;initialize
0240 a2 02    	ldx	#pzstrt		;set start location
0242 a9 00    	lda	#0		;clear accum
0244 95 00    clrzp	sta	$00,x		;clear mem
0246 e8       	inx			;bump index
0247 e0 30    	cpx	#lastzp		;see if past end
0249 d0 f9    	bne	clrzp		;loop if not
              ;save stack register for exit
024b ba       	tsx			;move to x
024c 86 2e    	stx	stksav		;save it
              ;calculate current ccm start
024e 38       	sec			;set carry
024f ad 04 01 	lda	pemjmp+1	;subtract ccm length from pem start
0252 e9 00    	sbc	#<ccmlng
0254 85 28    	sta	curccm
0256 ad 05 01 	lda	pemjmp+2
0259 e9 08    	sbc	#>ccmlng
025b 85 29    	sta	curccm+1
025d a9 b9    	lda	#<opnmsg	;send
025f a0 07    	ldy	#>opnmsg	;"opening"
0261 20 a5 07 	jsr	wrtmsg		;message
0264 a2 19    	ldx	#25		;read
0266 20 03 01 	jsr	pemjmp		;default drive
0269 85 23    	sta	defalt		;and save
026b 20 a8 05 	jsr	gns		;get new size
026e 20 d5 03 	jsr	bcdbyt		;pack into byte
0271 85 1b    	sta	adjust		;and save
              ;convert xx k to bytes
0273 a2 0a    	ldx	#10		;multiply
0275 06 1b    m1024	asl	adjust		;by
0277 26 1c    	rol	adjust+1	;1024
0279 ca       	dex			;to get
027a d0 f9    	bne	m1024		;size in bytes
              ;calculate room available for sysgen
027c a5 1b    	lda	adjust		;get msize
027e a4 1c    	ldy	adjust+1
0280 38       	sec			;now subtract ccm image start
0281 e9 00    	sbc	#<ccm
0283 85 2c    	sta	room		;and save
0285 98       	tya
0286 e9 0b    	sbc	#>ccm
0288 85 2d    	sta	room+1
028a 46 2d    	lsr	room+1		;divide by two
028c 66 2c    	ror	room
              ;get sim length
028e a9 00    	lda	#0		;clear size
0290 85 0d    	sta	size
0292 85 0e    	sta	size+1
0294 20 6b 05 	jsr	gss
0297 20 d5 03 	jsr	bcdbyt		;pack into byte
029a 85 2a    	sta	simlng		;and save
              ;convert xx pages to bytes
029c a2 08    	ldx	#8
029e 06 2a    m256	asl	simlng		;multiply
02a0 26 2b    	rol	simlng+1
02a2 ca       	dex
02a3 d0 f9    	bne	m256
              ;calculate new system length
02a5 18       	clc			;by adding sim length to syslng
02a6 ad b7 09 	lda	syslng
02a9 65 2a    	adc	simlng
02ab 8d b7 09 	sta	syslng
02ae ad b8 09 	lda	syslng+1
02b1 65 2b    	adc	simlng+1
02b3 8d b8 09 	sta	syslng+1	;and saving
              ;calculate new system start
02b6 38       	sec			;subtract
02b7 a5 1b    	lda	adjust		;system
02b9 ed b7 09 	sbc	syslng		;length
02bc 85 1b    	sta	adjust		;from
02be a5 1c    	lda	adjust+1	;top
02c0 ed b8 09 	sbc	syslng+1	;limit to
02c3 85 1c    	sta	adjust+1	;get new start
              ;make sure another sysgen is possible
02c5 a5 2c    	lda	room		;see if room
02c7 cd b7 09 	cmp	syslng		;is >= syslng
02ca a5 2d    	lda	room+1
02cc ed b8 09 	sbc	syslng+1
02cf b0 07    	bcs	rmok		;ok if is
02d1 a9 77    	lda	#<bigmsg	;else send too big message
02d3 a0 09    	ldy	#>bigmsg
02d5 4c cf 03 	jmp	errext		;and exit
              ;now calculate relocation distance
02d8 38       rmok	sec			;now
02d9 a5 1b    	lda	adjust		;subtract
02db e9 00    	sbc	#<ccm		;old start
02dd 85 1b    	sta	adjust		;from new
02df a5 1c    	lda	adjust+1	;to get
02e1 e9 0b    	sbc	#>ccm		;relocation
02e3 85 1c    	sta	adjust+1	;distance
              ;relocate ccm
02e5 a9 00    	lda	#<ccm		;set
02e7 a0 0b    	ldy	#>ccm		;pointer
02e9 85 19    	sta	point
02eb 84 1a    	sty	point+1
02ed 20 c2 04 	jsr	strtrl		;relocate it
              ;then pem
02f0 a9 00    	lda	#<pem		;set
02f2 a0 13    	ldy	#>pem		;pointer
02f4 85 19    	sta	point
02f6 84 1a    	sty	point+1
02f8 20 c2 04 	jsr	strtrl		;do it
              ;get new boot and sim
02fb 20 57 04 	jsr	gnbte		;get new boot
02fe 20 87 04 	jsr	gnsim		;and sim
              ;write system to specified drive
0301 a9 ff    wrtdrv	lda	#<crtmsg	;send
0303 a0 08    	ldy	#>crtmsg	;"dest drive"
0305 20 a5 07 	jsr	wrtmsg		;message
0308 20 23 05 	jsr	rinclw		;get answer
030b c9 41    	cmp	#'A'		;if less than "A"
030d 90 1e    	bcc	invd		;try again
030f c9 49    	cmp	#'H'+1		;if over "H"
0311 b0 1a    	bcs	invd		;also try again
0313 29 0f    	and	#%1111		;look at lsbs
0315 38       	sec			;drop
0316 e9 01    	sbc	#1		;one
0318 85 22    	sta	dstdrv		;and save
031a c8       	iny			;if
031b b9 bb 09 	lda	ctxt,y		;anything else
031e d0 0d    	bne	invd		;is error
0320 a5 22    	lda	dstdrv		;get drive
0322 20 e5 03 	jsr	jsseld		;and set
0325 85 04    	sta	dcbadd		;save dcb address
0327 84 05    	sty	dcbadd+1
0329 05 05    	ora	dcbadd+1	;see if legal
032b d0 0a    	bne	vld		;ok if not zero
032d a9 5b    invd	lda	#<invmsg	;else point to invalid drive message
032f a0 09    	ldy	#>invmsg
0331 20 a5 07 	jsr	wrtmsg		;send it
0334 4c 01 03 	jmp	wrtdrv		;and try again
0337 a0 02    vld	ldy	#2		;get sectors per track
0339 b1 04    	lda	(dcbadd),y
033b 85 08    	sta	nsectr
033d c8       	iny
033e b1 04    	lda	(dcbadd),y
0340 85 09    	sta	nsectr+1
0342 c8       	iny			;get number systems tracks
0343 b1 04    	lda	(dcbadd),y
0345 85 06    	sta	nmsstr
0347 c8       	iny
0348 b1 04    	lda	(dcbadd),y
034a 85 07    	sta	nmsstr+1
              ;send a logical sector 0 to translate to determine first physical sector
034c a9 00    	lda	#0		;low and high to 0
034e a8       	tay
034f 20 f1 03 	jsr	jsxlat		;and translate
              ;only look at low - assume first is probably 0 or 1
0352 85 2f    	sta	frstsc		;and save
              ;calculate actual amount of data to write
0354 a5 16    	lda	pointr		;see if part
0356 29 7f    	and	#$7f		;of a sector
0358 f0 0d    	beq	whlsec		;no so ok as is
035a a5 16    	lda	pointr		;get again
035c 29 80    	and	#$80		;capture mod 128
035e 18       	clc			;then add 128
035f 69 80    	adc	#128
0361 85 16    	sta	pointr
0363 90 02    	bcc	*+4		;with carry
0365 e6 17    	inc	pointr+1
0367 38       whlsec	sec			;calculate actual data length
0368 a5 16    	lda	pointr
036a e9 00    	sbc	#<ccm
036c 8d b7 09 	sta	syslng
036f a5 17    	lda	pointr+1
0371 e9 0b    	sbc	#>ccm
0373 8d b8 09 	sta	syslng+1	;and save
              ;calculate total sector count
0376 ad b7 09 	lda	syslng
0379 a2 07    	ldx	#7		;divide by 128
037b 4e b8 09 d128	lsr	syslng+1
037e 6a       	ror	a
037f ca       	dex
0380 d0 f9    	bne	d128
0382 18       	clc			;add one for boot
0383 69 01    	adc	#1
0385 85 0a    	sta	ttlsec
              ;At this time it is assumed that TTLSEC is valid
              ;as an 8-bit number. That is reasonable as that
              ;allows an image length of 255*128 = 32640 bytes.
              ;There is no circumstance in which a longer image
              ;makes any sense. We need to save TTLSEC for use
              ;in the actual image write so to
              ;calculate number of tracks needed we will use
              ;TRKCNT as a temp holder of TTLSEC.
0387 a5 0a    	lda	ttlsec		;copy data
0389 85 0b    	sta	trkcnt
038b a9 00    	lda	#0		;including missing
038d 85 0c    	sta	trkcnt+1	;high byte
038f a2 00    	ldx	#0		;use x as counter
0391 e8       tcntl	inx
              ;do trkcnt - nmsstr --> trkcnt until result 0
              ;or there is no borrow
0392 38       	sec
0393 a5 0b    	lda	trkcnt
0395 e5 08    	sbc	nsectr		;drop by number in track
0397 85 0b    	sta	trkcnt
0399 a5 0c    	lda	trkcnt+1
039b e5 09    	sbc	nsectr+1
039d 85 0c    	sta	trkcnt+1
              ;check result if c=0 there was a borrow so x shows the
              ;number of tracks needed since nsectr > ttlsec. X also
              ;reflects number of tracks if final result is zero.
039f 90 06    	bcc	knowx		;there was a borrow
              ;Now test for zero result
03a1 a5 0b    	lda	trkcnt		;or lower
03a3 05 0c    	ora	trkcnt+1	;and upper
03a5 d0 ea    	bne	tcntl		;loop if more
03a7 86 0b    knowx	stx	trkcnt		;set counter
03a9 ca       	dex			;drop for compare
03aa e4 06    	cpx	nmsstr		;compare to avail
03ac b0 1d    	bcs	romerr		;error if too big
03ae 20 e2 03 	jsr	jshome		;home it
03b1 a9 80    	lda	#<boot		;set pointer
03b3 a0 0a    	ldy	#>boot		;to
03b5 85 16    	sta	pointr		;boot
03b7 84 17    	sty	pointr+1	;start
03b9 20 05 04 wrsysl	jsr	writit		;write a track
03bc c6 0b    	dec	trkcnt		;drop count
03be d0 f9    	bne	wrsysl		;loop if more
              ;done - clean up and exit
03c0 20 88 07 cupext	jsr	stdfbf		;point back to default
03c3 a6 2e    	ldx	stksav		;get stack register
03c5 9a       	txs			;and set
03c6 a5 23    	lda	defalt		;get default
03c8 4c e5 03 	jmp	jsseld		;select it
              ;room error exit
03cb a9 35    romerr	lda	#<rommsg	;send not enough track message
03cd a0 09    	ldy	#>rommsg
03cf 20 a5 07 errext	jsr	wrtmsg
03d2 4c c0 03 	jmp	cupext		;clean up and exit
              ;pack bcd size into byte
03d5 18       bcdbyt	clc			;clear carry
03d6 a9 00    	lda	#0		;and accum
03d8 a2 0a    	ldx	#10		;then add high
03da 65 0e    	adc	size+1		;to accum
03dc ca       	dex			;10
03dd d0 fb    	bne	*-3		;times
03df 65 0d    	adc	size		;then add low
03e1 60       	rts			;and quit
              ;jumps to sim routines
              ;only the low part of the address is shown here - page is captured from
              ;existing warm boot entry point
              ;home
03e2 4c 18 00 jshome	jmp	24
              ;select drive
03e5 4c 1b 00 jsseld	jmp	27
              ;set track
03e8 4c 1e 00 jssett	jmp	30
              ;set sector
03eb 4c 21 00 jssets	jmp	33
              ;set dma
03ee 4c 24 00 jssetd	jmp	36
              ;translate sectort
03f1 4c 33 00 jsxlat	jmp	51
              ;write sector
03f4 a9 01    jswrit	lda	#1		;force immediate write
03f6 20 2a 00 	jsr	42
03f9 29 ff    	and	#$ff		;check for error
03fb d0 01    	bne	twrerr		;if so quit
03fd 60       	rts
03fe a9 97    twrerr	lda	#<wermsg	;point to error msg
0400 a0 09    	ldy	#>wermsg
0402 4c cf 03 	jmp	errext		;and exit
              ;write nsectr sectors (records) in track but
              ;use ttlsec as counter to ensure only what must be written
              ;is actually written to drive.
0405 a5 02    writit	lda	trknum		;get track number
0407 a4 03    	ldy	trknum+1
0409 20 e8 03 	jsr	jssett		;set it
040c e6 02    	inc	trknum		;bump for next
040e d0 02    	bne	*+4
0410 e6 03    	inc	trknum+1
0412 a5 08    	lda	nsectr		;set counter
0414 a4 09    	ldy	nsectr+1
0416 85 24    	sta	seccnt		;to number sectors in track
0418 84 25    	sty	seccnt+1
041a a5 2f    	lda	frstsc		;from value captured earlier
041c a0 00    	ldy	#0		;set starting sector
041e 85 26    	sta	secnum		;number (probably 0 or 1)
0420 84 27    	sty	secnum+1
0422 a5 26    wrtslp	lda	secnum		;get sector number
0424 a4 27    	ldy	secnum+1
0426 20 eb 03 	jsr	jssets		;set it
0429 a5 16    	lda	pointr		;get
042b a4 17    	ldy	pointr+1	;pointer
042d 20 ee 03 	jsr	jssetd		;set address
0430 20 f4 03 	jsr	jswrit		;write sector
0433 c6 0a    	dec	ttlsec		;drop count
0435 f0 1f    	beq	ex00		;done if all written
0437 18       	clc			;then
0438 a5 16    	lda	pointr		;bump
043a 69 80    	adc	#128		;by
043c 85 16    	sta	pointr		;128
043e 90 02    	bcc	*+4		;for
0440 e6 17    	inc	pointr+1	;next
0442 e6 26    	inc	secnum		;bump sector number
0444 d0 02    	bne	*+4
0446 e6 27    	inc	secnum+1
0448 a5 24    	lda	seccnt
044a d0 02    	bne	*+4
044c c6 25    	dec	seccnt+1
044e c6 24    	dec	seccnt		;drop count
0450 a5 24    	lda	seccnt
0452 05 25    	ora	seccnt+1
0454 d0 cc    	bne	wrtslp		;loop if more
0456 60       ex00	rts
              ;get new boot
0457 a9 00    gnbte	lda	#<btemsg	;send
0459 a0 08    	ldy	#>btemsg	;"boot name"
045b 20 a5 07 	jsr	wrtmsg		;message
045e 20 23 05 	jsr	rinclw		;get response
0461 20 f4 05 	jsr	inptfn		;convert to fcb
0464 b0 1a    	bcs	gnberr		;branch if error
0466 a9 80    	lda	#<boot		;offset
0468 a0 0a    	ldy	#>boot		;is same
046a 85 13    	sta	offset		;as boot
046c 84 14    	sty	offset+1	;start
046e 85 0f    	sta	lokim		;as is lower
0470 84 10    	sty	lokim+1		;limit
0472 a9 00    	lda	#<(boot+128)	;set
0474 a0 0b    	ldy	#>(boot+128)	;upper
0476 85 11    	sta	hikim		;limit
0478 84 12    	sty	hikim+1		;then
047a 20 48 06 	jsr	xqread		;read file
047d b0 01    	bcs	gnberr		;branch if error
047f 60       	rts
0480 a9 31    gnberr	lda	#<flemsg	;send
0482 a0 08    	ldy	#>flemsg	;"file error"
0484 4c cf 03 	jmp	errext		;message and exit
              ;get new sim
0487 a9 b6    gnsim	lda	#<simmsg	;send
0489 a0 08    	ldy	#>simmsg	;"sim name"
048b 20 a5 07 	jsr	wrtmsg		;message
048e 20 23 05 	jsr	rinclw		;get input
0491 20 f4 05 	jsr	inptfn		;convert to fcb
0494 b0 29    	bcs	gnsirr		;branch if error
0496 a9 00    	lda	#<sim		;set lower
0498 a0 1f    	ldy	#>sim		;limit
049a 85 0f    	sta	lokim		;for
049c 84 10    	sty	lokim+1		;load
049e a5 28    	lda	curccm		;and
04a0 a4 29    	ldy	curccm+1	;upper
04a2 85 11    	sta	hikim		;limit
04a4 84 12    	sty	hikim+1		;for load
04a6 a5 1b    	lda	adjust		;get
04a8 a4 1c    	ldy	adjust+1	;relocation
